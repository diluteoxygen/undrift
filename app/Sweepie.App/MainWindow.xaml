<Window
    x:Class="Sweepie.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sweepie.App"
    xmlns:vm="using:Sweepie.App.ViewModels"
    mc:Ignorable="d"
    Title="Sweepie — Space Reclaiming for Developers">

    <Grid Margin="28,16,28,20" RowSpacing="14" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- Error / Warning InfoBar -->
            <RowDefinition Height="Auto" />
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Controls & Scan Input -->
            <RowDefinition Height="Auto" />
            <!-- Metrics Cards -->
            <RowDefinition Height="Auto" />
            <!-- Filter & Selection Bar -->
            <RowDefinition Height="Auto" />
            <!-- Candidate Items List / Empty State -->
            <RowDefinition Height="*" />
            <!-- Action / Review Bottom Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Error InfoBar -->
        <InfoBar Grid.Row="0"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Severity="Error"
                 Title="Notice"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsClosable="True" />

        <!-- Header -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" Spacing="2">
                <TextBlock Text="Sweepie" FontSize="26" FontWeight="SemiBold" FontFamily="{StaticResource AppFontFamily}" />
                <TextBlock Text="Precision developer disk space reclaimer • Direct MFT speed • Zero telemetry" 
                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                <TextBlock Text="🔒 100% Offline &amp; Private" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="Medium" />
            </Border>
        </Grid>

        <!-- Scan Input Bar -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Text="{x:Bind ViewModel.TargetPath, Mode=TwoWay}"
                     PlaceholderText="Enter drive letter (e.g. C:) or project directory..."
                     VerticalAlignment="Center" Height="38" />

            <Button Grid.Column="1" Command="{x:Bind ViewModel.StartScanCommand}"
                    Style="{ThemeResource AccentButtonStyle}" Height="38" Padding="20,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="16" Height="16" 
                                  Visibility="{x:Bind local:Converters.BoolToVisibility(ViewModel.IsScanning), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind local:Converters.ScanButtonText(ViewModel.IsScanning), Mode=OneWay}" 
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Stats Dashboard Cards -->
        <Grid Grid.Row="3" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Total Reclaimable -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="3">
                    <TextBlock Text="TOTAL RECLAIMABLE" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.TotalReclaimableDisplay, Mode=OneWay}" FontSize="24" FontWeight="Bold" />
                </StackPanel>
            </Border>

            <!-- Scan Speed & Files -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="3">
                    <TextBlock Text="SCAN TIME / FILES" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.ScanTimeDisplay, Mode=OneWay}" FontSize="24" FontWeight="Bold" />
                </StackPanel>
            </Border>

            <!-- Selected to Clean -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="3">
                    <TextBlock Text="SELECTED TO CLEAN" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedReclaimableDisplay, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filter & Selection Controls -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox ItemsSource="{x:Bind ViewModel.AvailableCategories}"
                      SelectedItem="{x:Bind ViewModel.SelectedCategoryFilter, Mode=TwoWay}"
                      Width="220" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Select All Safe" Command="{x:Bind ViewModel.SelectAllSafeCommand}" />
                <Button Content="Deselect All" Command="{x:Bind ViewModel.DeselectAllCommand}" />
            </StackPanel>
        </Grid>

        <!-- Candidate Results List / Empty States -->
        <Border Grid.Row="5" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <!-- Active Results ListView -->
                <ListView ItemsSource="{x:Bind ViewModel.FilteredCandidates, Mode=OneWay}"
                          SelectionMode="None"
                          Visibility="{x:Bind local:Converters.BoolToVisibility(ViewModel.HasResults), Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CandidateViewModel">
                            <Grid Padding="14,10" ColumnSpacing="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Checkbox -->
                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          IsEnabled="{x:Bind CanSelect}"
                                          VerticalAlignment="Center" />

                                <!-- Category FontIcon & Name -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind CategoryGlyph}"
                                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                                              FontSize="16"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind CategoryDisplayName}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Path & Safety Reason -->
                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayPath}"
                                               FontFamily="Cascadia Code, Consolas, monospace"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind SafetyReason}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Hardlink Caveat Badge (pnpm store, etc.) -->
                                <Border Grid.Column="3"
                                        Visibility="{x:Bind local:Converters.BoolToVisibility(HasHardlinks), Mode=OneWay}"
                                        Background="#180078D4"
                                        BorderBrush="#400078D4"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="{x:Bind SizeCaveat}">
                                    <TextBlock Text="⚡ Shared (pnpm)" FontSize="10" Foreground="#0078D4" FontWeight="SemiBold" />
                                </Border>

                                <!-- Safety Badge Pill -->
                                <Border Grid.Column="4"
                                        Background="{x:Bind SafetyBadgeBackground}"
                                        CornerRadius="10"
                                        Padding="10,3"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind SafetyBadgeText}"
                                               FontSize="11"
                                               Foreground="{x:Bind SafetyBadgeForeground}"
                                               FontWeight="SemiBold" />
                                </Border>

                                <!-- Size Badge (Primary Bold) -->
                                <TextBlock Grid.Column="5"
                                           Text="{x:Bind HumanSize}"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           Width="95"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State Container -->
                <Grid Visibility="{x:Bind local:Converters.BoolToVisibility(ViewModel.IsEmptyResults), Mode=OneWay}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="24">

                    <!-- 1. Initial State (before scan) -->
                    <StackPanel Spacing="10" HorizontalAlignment="Center"
                                Visibility="{x:Bind local:Converters.InverseBoolToVisibility(ViewModel.HasScanned), Mode=OneWay}">
                        <Image Source="ms-appx:///Assets/capybara_nobackground.png" Width="96" Height="96" HorizontalAlignment="Center" Stretch="Uniform" />
                        <TextBlock Text="Ready to scan for reclaimable space" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Enter a drive letter (e.g. C:) or project path above and click 'Scan MFT' to discover disposable dependencies (node_modules, target, .venv), build artifacts, and stale installers."
                                   FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 2. Zero-Results State (after scan) -->
                    <StackPanel Spacing="10" HorizontalAlignment="Center"
                                Visibility="{x:Bind local:Converters.BoolToVisibility(ViewModel.HasScanned), Mode=OneWay}">
                        <Image Source="ms-appx:///Assets/capybara_nobackground.png" Width="96" Height="96" HorizontalAlignment="Center" Stretch="Uniform" Opacity="0.8" />
                        <TextBlock Text="No reclaimable artifacts found" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Your drive or project directory is already clean. No disposable build caches or dead dependencies were detected."
                                   FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <CheckBox Content="Move to Recycle Bin (default &amp; recommended)" 
                          IsChecked="{x:Bind ViewModel.UseRecycleBin, Mode=TwoWay}" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button Grid.Column="1" Command="{x:Bind ViewModel.CleanSelectedCommand}"
                    Style="{ThemeResource AccentButtonStyle}" Height="40" Padding="24,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsCleaning, Mode=OneWay}" Width="16" Height="16" 
                                  Visibility="{x:Bind local:Converters.BoolToVisibility(ViewModel.IsCleaning), Mode=OneWay}" />
                    <TextBlock Text="Reclaim Selected Space" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
