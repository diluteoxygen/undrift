<Window
    x:Class="Sweepie.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sweepie.App"
    xmlns:vm="using:Sweepie.App.ViewModels"
    mc:Ignorable="d"
    Title="Sweepie — Find extra space on your PC">

    <!--
        Layout: Scrollable single-column page so it works on smaller screens.
        Outer ScrollViewer keeps the header pinned in a sticky fashion via the
        inner Grid's row structure. The main content area has a min-height so
        the capybara art is always comfortably visible.
    -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- Error banner (zero height when not shown) -->
            <RowDefinition Height="Auto" />
            <!-- Scrollable main body -->
            <RowDefinition Height="*" />
            <!-- Fixed bottom action bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!--   ROW 0 — ERROR / INFO BANNER                                     -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <InfoBar Grid.Row="0"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Severity="Warning"
                 Title="Heads up"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsClosable="True" />

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!--   ROW 1 — SCROLLABLE MAIN CONTENT                                 -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20,28,8" Spacing="16">

                <!-- ── HERO CARD ── Capybara + status + scan input ────────── -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20,18">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Capybara mascot -->
                        <Image Grid.Column="0"
                               Source="ms-appx:///Assets/capybara_nobackground.png"
                               Width="88" Height="88"
                               Stretch="Uniform"
                               VerticalAlignment="Center" />

                        <!-- Text + scan bar -->
                        <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">

                            <StackPanel Spacing="3">
                                <TextBlock Text="Sweepie"
                                           FontSize="26" FontWeight="Bold"
                                           FontFamily="{StaticResource AppFontFamily}" />
                                <TextBlock Text="{x:Bind ViewModel.HeroSubtitle, Mode=OneWay}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Scan input row -->
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{x:Bind ViewModel.TargetPath, Mode=TwoWay}"
                                         PlaceholderText="Drive letter or folder, e.g.  C:\"
                                         VerticalAlignment="Center"
                                         Height="38" />

                                <Button Grid.Column="1"
                                        Command="{x:Bind ViewModel.StartScanCommand}"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Height="38" Padding="20,0"
                                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                                                      Width="16" Height="16"
                                                      Visibility="{x:Bind local:Converters.BoolToVisibility(ViewModel.IsScanning), Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind local:Converters.ScanButtonText(ViewModel.IsScanning), Mode=OneWay}"
                                                   VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── METRICS ROW  (visible only after a scan) ───────────── -->
                <Grid ColumnSpacing="12"
                      Visibility="{x:Bind local:Converters.BoolToVisibility(ViewModel.HasScanned), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Space found -->
                    <Border Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16,12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Space found" FontSize="11" FontWeight="Bold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalReclaimableDisplay, Mode=OneWay}"
                                       FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <!-- Space to free (selected) -->
                    <Border Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16,12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Ready to free" FontSize="11" FontWeight="Bold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedReclaimableDisplay, Mode=OneWay}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Scan speed -->
                    <Border Grid.Column="2"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16,12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Scan time" FontSize="11" FontWeight="Bold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ScanTimeDisplay, Mode=OneWay}"
                                       FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── RESULTS AREA ────────────────────────────────────────── -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10"
                        MinHeight="280">
                    <Grid>

                        <!-- RESULTS: filter bar + list (shown when there are results) -->
                        <StackPanel Spacing="0"
                                    Visibility="{x:Bind local:Converters.BoolToVisibility(ViewModel.HasResults), Mode=OneWay}">

                            <!-- Filter bar -->
                            <Grid Padding="14,12" ColumnSpacing="10"
                                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                  BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Show:" VerticalAlignment="Center"
                                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{x:Bind ViewModel.AvailableCategories}"
                                          SelectedItem="{x:Bind ViewModel.SelectedCategoryFilter, Mode=TwoWay}"
                                          MinWidth="180" />

                                <!-- spacer -->

                                <Button Grid.Column="3" Content="Select all safe"
                                        Command="{x:Bind ViewModel.SelectAllSafeCommand}"
                                        FontSize="12" />
                                <Button Grid.Column="4" Content="Deselect all"
                                        Command="{x:Bind ViewModel.DeselectAllCommand}"
                                        FontSize="12" />
                            </Grid>

                            <!-- Candidate list -->
                            <ListView ItemsSource="{x:Bind ViewModel.FilteredCandidates, Mode=OneWay}"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CandidateViewModel">
                                        <Grid Padding="14,11" ColumnSpacing="14"
                                              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                              BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <!-- Checkbox -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- Glyph icon -->
                                                <ColumnDefinition Width="28" />
                                                <!-- Category name + description -->
                                                <ColumnDefinition Width="*" />
                                                <!-- Hardlink badge -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- Safety badge -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- Size -->
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox -->
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{x:Bind CanSelect}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,4,0" />

                                            <!-- Category icon -->
                                            <FontIcon Grid.Column="1"
                                                      Glyph="{x:Bind CategoryGlyph}"
                                                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                      FontSize="18"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      VerticalAlignment="Center" />

                                            <!-- Category name + friendly path + description -->
                                            <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind CategoryDisplayName}"
                                                           FontWeight="SemiBold" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" />
                                                <!-- Friendly path (collapsible developer detail) -->
                                                <TextBlock Text="{x:Bind DisplayPath}"
                                                           FontFamily="Cascadia Code, Consolas, monospace"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind SafetyReason}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Shared-storage badge (pnpm, etc.) -->
                                            <Border Grid.Column="3"
                                                    Visibility="{x:Bind local:Converters.BoolToVisibility(HasHardlinks), Mode=OneWay}"
                                                    Background="#180078D4"
                                                    BorderBrush="#400078D4"
                                                    BorderThickness="1"
                                                    CornerRadius="10" Padding="8,3"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="{x:Bind SizeCaveat}">
                                                <TextBlock Text="⚡ Shared" FontSize="10"
                                                           Foreground="#0078D4" FontWeight="SemiBold" />
                                            </Border>

                                            <!-- Safety badge pill -->
                                            <Border Grid.Column="4"
                                                    Background="{x:Bind SafetyBadgeBackground}"
                                                    CornerRadius="10" Padding="10,3"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind SafetyBadgeText}"
                                                           FontSize="11"
                                                           Foreground="{x:Bind SafetyBadgeForeground}"
                                                           FontWeight="SemiBold" />
                                            </Border>

                                            <!-- Size badge -->
                                            <TextBlock Grid.Column="5"
                                                       Text="{x:Bind HumanSize}"
                                                       FontWeight="SemiBold" FontSize="15"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <!-- EMPTY STATE container (shown when no results) -->
                        <Grid Visibility="{x:Bind local:Converters.BoolToVisibility(ViewModel.IsEmptyResults), Mode=OneWay}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="24">

                            <!-- 1. Before first scan -->
                            <StackPanel Spacing="12" HorizontalAlignment="Center"
                                        Visibility="{x:Bind local:Converters.InverseBoolToVisibility(ViewModel.HasScanned), Mode=OneWay}">
                                <Image Source="ms-appx:///Assets/capybara_nobackground.png"
                                       Width="110" Height="110"
                                       HorizontalAlignment="Center" Stretch="Uniform" />
                                <TextBlock Text="Hi! I'm Sweepie 👋"
                                           FontSize="20" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Enter a drive letter above (like C:) and tap Scan My PC. I'll find files you no longer need — things like old setup files, browser junk, and app caches. Your photos, documents, and music are always kept safe."
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="420"
                                           TextAlignment="Center" HorizontalAlignment="Center" />
                                <!-- Private badge -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="14,6" HorizontalAlignment="Center">
                                    <TextBlock Text="🔒 100% offline — nothing ever leaves your PC"
                                               FontSize="12"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                               FontWeight="Medium" />
                                </Border>
                            </StackPanel>

                            <!-- 2. After scan, zero results found -->
                            <StackPanel Spacing="12" HorizontalAlignment="Center"
                                        Visibility="{x:Bind local:Converters.BoolToVisibility(ViewModel.HasScanned), Mode=OneWay}">
                                <Image Source="ms-appx:///Assets/capybara_nobackground.png"
                                       Width="110" Height="110"
                                       HorizontalAlignment="Center" Stretch="Uniform"
                                       Opacity="0.85" />
                                <TextBlock Text="Looking great! 🎉"
                                           FontSize="20" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Sweepie didn't find anything worth cleaning here. Your PC is already in good shape."
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="380"
                                           TextAlignment="Center" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                    </Grid>
                </Border>

                <!-- ── PRIVATE &amp; SAFE NOTE (always visible, subtle) ─────── -->
                <Border Padding="14,8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🛡️" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="Sweepie never touches your Documents, Pictures, Music, Videos, Desktop, or OneDrive — only recoverable junk and caches."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!--   ROW 2 — STICKY BOTTOM ACTION BAR                                -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="28,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: recycle bin toggle + status -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                    <CheckBox IsChecked="{x:Bind ViewModel.UseRecycleBin, Mode=TwoWay}"
                              VerticalAlignment="Center">
                        <TextBlock Text="Move to Recycle Bin (you can undo this)" FontSize="13" />
                    </CheckBox>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="28,0,0,0" />
                </StackPanel>

                <!-- Right: CLEAN UP button — large, prominent, friendly -->
                <Button Grid.Column="1"
                        Command="{x:Bind ViewModel.CleanSelectedCommand}"
                        Style="{ThemeResource AccentButtonStyle}"
                        Height="44" Padding="32,0"
                        FontSize="15"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsCleaning, Mode=OneWay}"
                                      Width="16" Height="16"
                                      Visibility="{x:Bind local:Converters.BoolToVisibility(ViewModel.IsCleaning), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind local:Converters.CleanButtonText(ViewModel.IsCleaning), Mode=OneWay}"
                                   VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

    </Grid>
</Window>
