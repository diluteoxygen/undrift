<Window
    x:Class="Undrift.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Undrift.App"
    xmlns:vm="using:Undrift.App.ViewModels"
    mc:Ignorable="d"
    Title="Undrift — Space Reclaiming for Developers">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Window.Resources>
        <local:ScanButtonTextConverter x:Key="ScanButtonTextConverter" />
    </Window.Resources>

    <Grid Margin="28,20,28,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Controls & Scan Input -->
            <RowDefinition Height="Auto" />
            <!-- Metrics Cards -->
            <RowDefinition Height="Auto" />
            <!-- Filter & Selection Bar -->
            <RowDefinition Height="Auto" />
            <!-- Candidate Items List -->
            <RowDefinition Height="*" />
            <!-- Action / Review Bottom Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBlock Text="Undrift" FontSize="26" FontWeight="SemiBold" FontFamily="{StaticResource AppFontFamily}" />
                <TextBlock Text="Precision developer disk space reclaimer • Direct MFT speed • Zero telemetry" 
                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                <TextBlock Text="🔒 100% Offline &amp; Private" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="Medium" />
            </Border>
        </Grid>

        <!-- Scan Input Bar -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Text="{x:Bind ViewModel.TargetPath, Mode=TwoWay}"
                     PlaceholderText="Enter drive letter (e.g. C:) or project path..."
                     VerticalAlignment="Center" Height="38" />

            <Button Grid.Column="1" Command="{x:Bind ViewModel.StartScanCommand}"
                    Style="{ThemeResource AccentButtonStyle}" Height="38" Padding="20,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="16" Height="16" 
                                  Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource ScanButtonTextConverter}}" 
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Stats Dashboard Cards -->
        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Total Reclaimable -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,14">
                <StackPanel Spacing="4">
                    <TextBlock Text="TOTAL RECLAIMABLE" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.TotalReclaimableDisplay, Mode=OneWay}" FontSize="24" FontWeight="Bold" />
                </StackPanel>
            </Border>

            <!-- Scan Speed & Files -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,14">
                <StackPanel Spacing="4">
                    <TextBlock Text="SCAN TIME / FILES" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.ScanTimeDisplay, Mode=OneWay}" FontSize="24" FontWeight="Bold" />
                </StackPanel>
            </Border>

            <!-- Selected to Clean -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,14">
                <StackPanel Spacing="4">
                    <TextBlock Text="SELECTED TO CLEAN" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedReclaimableDisplay, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filter & Selection Controls -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox ItemsSource="{x:Bind ViewModel.AvailableCategories}"
                      SelectedItem="{x:Bind ViewModel.SelectedCategoryFilter, Mode=TwoWay}"
                      Width="220" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Select All Safe" Command="{x:Bind ViewModel.SelectAllSafeCommand}" />
                <Button Content="Deselect All" Command="{x:Bind ViewModel.DeselectAllCommand}" />
            </StackPanel>
        </Grid>

        <!-- Candidate Results List -->
        <Border Grid.Row="4" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8">
            <ListView ItemsSource="{x:Bind ViewModel.FilteredCandidates, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CandidateViewModel">
                        <Grid Padding="12,10" ColumnSpacing="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Checkbox -->
                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                      IsEnabled="{x:Bind CanSelect}"
                                      VerticalAlignment="Center" />

                            <!-- Category Glyph & Name -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Width="190">
                                <TextBlock Text="{x:Bind CategoryGlyph}" FontSize="18" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind CategoryDisplayName}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Path & Safety Reason -->
                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind DisplayPath}" FontFamily="Consolas, monospace" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind SafetyReason}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Safety Badge -->
                            <Border Grid.Column="3" Background="{x:Bind SafetyBadgeBackground}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind SafetyBadgeText}" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                            </Border>

                            <!-- Size Badge -->
                            <TextBlock Grid.Column="4" Text="{x:Bind HumanSize}" FontWeight="Bold" FontSize="14" Width="90" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <CheckBox Content="Move to Recycle Bin (Default &amp; Recommended)" 
                          IsChecked="{x:Bind ViewModel.UseRecycleBin, Mode=TwoWay}" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button Grid.Column="1" Command="{x:Bind ViewModel.CleanSelectedCommand}"
                    Style="{ThemeResource AccentButtonStyle}" Height="40" Padding="24,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsCleaning, Mode=OneWay}" Width="16" Height="16" 
                                  Visibility="{x:Bind ViewModel.IsCleaning, Mode=OneWay}" />
                    <TextBlock Text="Reclaim Selected Space" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
